# Copy to .env for the full-stack server only. Never commit real values.

# ── Required backend configuration ──────────────────────────────
APP_ID=                    # Kimi OAuth application ID
APP_SECRET=                # Strong secret used for OAuth and session signing
DATABASE_URL=              # MySQL URL: mysql://user:pass@host:port/database
KIMI_AUTH_URL=             # Kimi OAuth issuer, e.g. https://auth.kimi.com
KIMI_OPEN_URL=             # Kimi Open Platform base URL

# ── OAuth / authorization ───────────────────────────────────────
OAUTH_CALLBACK_URL=        # Optional exact public callback, e.g. https://example.com/api/oauth/callback
OWNER_UNION_ID=            # Optional union ID promoted to admin on first login

# ── Kimi agent gateway (server only) ────────────────────────────
AGENT_GW_BASE_URL=https://agent-gw.kimi.com/coding/v1
AGENT_GW_API_KEY=          # Required for image/video/speech/search/storage tools
DEFAULT_AI_BASE_URL=https://agent-gw.kimi.com/coding/v1
DEFAULT_AI_API_KEY=        # Optional LLM polish; deterministic fallback is used when empty
DEFAULT_AI_MODEL=kimi:kimi-k2.5

# ── Runtime ─────────────────────────────────────────────────────
PORT=3000

# ── MiniMax smoke test only (server/process environment) ────────
# Prefer the no-echo prompt documented in README.md instead of storing this.
MINIMAX_API_KEY=
# MINIMAX_RESUME_FILE=/private/path/to/task.json
# MINIMAX_OUTPUT_DIR=/private/path/outside/the/repository

# GitHub Pages uses only these non-secret build flags. The workflow sets them.
# VITE_STATIC_DEMO=true
# VITE_BASE_PATH=/Atlas-Website/
